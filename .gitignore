# build output
build/
bin/
out/
*.class
*.jar

# IDE and editor
.idea/
*.iml
.vscode/
.DS_Store

# local scratch
results_backup/
*.log
*.hprof

# ... except a run's own console logs, which are evidence that goes with its numbers.
# manifest.json points at them, so dropping them leaves a run unable to explain itself.
!results/**/*.log

# Databases are not kept in this repository. They are shared across several studies
# and are pinned to a release of https://github.com/tran-minh-thai/huspm-datasets.
# Fetch them with ./fetch-datasets.ps1 (or .sh); see README.
datasets/*
!datasets/.gitkeep

# Machine-specific operating notes, kept outside the repository on purpose.
# Anything needed to reproduce a result belongs in README instead.
run.txt

# per-run build directories of analysis/record_run.py
build-*/
__pycache__/
*.pyc
